<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="帧率悬浮窗"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="在游戏画面上实时显示真实帧率 · 读取系统合成层的上屏时间戳"
            android:textColor="#77808A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#F1F3F5"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="初始化…"
            android:textColor="#2B3138"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="显示帧时间曲线"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swGraph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="悬浮窗大小：100%"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/sbSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="80"
            android:progress="25" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:text="开启悬浮窗"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnDiag"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="图层诊断 / 手动选择"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:text="使用步骤：\n1. 授予「显示在其他应用上层」权限。\n2. 点「开启悬浮窗」，此时会弹出 root 授权，请选择允许。\n3. 回到游戏，悬浮窗会自动识别游戏图层并开始显示帧率。\n4. 拖动悬浮窗可移动位置，轻点可开关曲线，通知栏可关闭。"
            android:textColor="#77808A"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
